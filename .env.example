# ---------------------------------------------------------------------------
# ServerlessMailer — environment
#
# Every value below is read at runtime, never at build time. Secrets differ per
# environment (§12): never share values between preview and production.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public origin of this deployment. Used to build confirmation, unsubscribe and
# tracking URLs, which must be absolute and stable for years.
APP_BASE_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=serverless_mailer

# --- Secrets ----------------------------------------------------------------
# Generate each with:  openssl rand -hex 32
# CRON_SECRET is auto-provisioned by Vercel; set it manually for local dev.
CRON_SECRET=
SESSION_SECRET=
CONFIRM_TOKEN_SECRET=
UNSUBSCRIBE_SECRET=
TRACKING_SECRET=

# --- Admin bootstrap --------------------------------------------------------
# Used once, only when the `admins` collection is empty. Remove afterwards.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- AWS SES ----------------------------------------------------------------
SES_REGION=eu-west-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Account-level send rate in messages/second. Lower this instantly if
# reputation degrades (§7.5). SES default for a new account is 14.
SES_MAX_SEND_RATE=14

# `ses` sends for real. `console` writes messages to stdout instead — use it
# locally and in preview so a mistake cannot reach a real inbox.
MAILER_DRIVER=console

# --- Send pipeline tuning ---------------------------------------------------
# Sized to the SES quota, not to the clock (§7.2). Default: derived from
# SES_MAX_SEND_RATE * CRON_RUN_BUDGET_MS, capped so one run cannot monopolise
# the quota when invocations overlap.
MAX_BATCHES_PER_RUN=
CRON_RUN_BUDGET_MS=45000
BATCH_LEASE_MS=120000
MAX_BATCH_ATTEMPTS=5

# --- Circuit breaker (§7.8) -------------------------------------------------
# Auto-pause a sending campaign when its complaint rate exceeds the threshold.
# 0.001 = 0.1%. SES puts an account under review at that level.
COMPLAINT_RATE_THRESHOLD=0.001
# Below this many delivered messages the rate is statistically meaningless.
COMPLAINT_MIN_DELIVERED=500
BOUNCE_RATE_THRESHOLD=0.05
BOUNCE_MIN_DELIVERED=500
# Optional POST target for circuit-breaker and failed-batch alerts.
ALERT_WEBHOOK_URL=

# --- Sending guardrails -----------------------------------------------------
# Sends above this recipient count require the operator to type the list name
# to confirm (§6.7).
TYPED_CONFIRM_THRESHOLD=1000

# --- Signup abuse controls (§12) --------------------------------------------
SIGNUP_RATE_LIMIT_PER_IP=10
SIGNUP_RATE_LIMIT_WINDOW_SEC=3600
CONFIRM_RESEND_INTERVAL_SEC=3600
# Optional Cloudflare Turnstile. Leave blank to disable.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set to 1 to skip MX lookups (offline development and CI only).
DISABLE_MX_CHECK=0
