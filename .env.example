# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=newsletter

# Public origin used to build confirm / unsubscribe / tracking URLs
APP_BASE_URL=https://mail.example.com

# Secrets — separate values per environment, all 32+ random bytes
CRON_SECRET=                 # auto-provisioned by Vercel
CONFIRM_TOKEN_SECRET=
UNSUBSCRIBE_SECRET=
TRACKING_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# AWS SES
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Send pacing — lower these instantly if reputation degrades
SES_MAX_SEND_RATE=14
MAX_BATCHES_PER_RUN=10
BATCH_SIZE=50
BATCH_LEASE_MS=120000
MAX_BATCH_ATTEMPTS=5
CRON_BUDGET_MS=45000

# Safety thresholds
COMPLAINT_CIRCUIT_BREAKER_RATE=0.001
COMPLAINT_CIRCUIT_BREAKER_MIN_DELIVERED=100
TYPED_CONFIRMATION_THRESHOLD=1000
TRANSIENT_BOUNCE_SUPPRESSION_THRESHOLD=3
PENDING_EXPIRY_DAYS=7

# Optional
TURNSTILE_SECRET_KEY=
UNSUBSCRIBE_MAILTO=unsubscribe@news.example.com
TRACKING_URL_ALLOWLIST=
SKIP_MX_CHECK=false
